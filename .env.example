# defaults baked into server/integrations/iris.js — see the note at the top
# of that file.
# IRIS_TICKETS_PATH=/v1/tickets
# IRIS_COMMENTS_PATH=/v1/tickets/{id}/comments

# --- Missive ---
MISSIVE_BASE_URL=https://public.missiveapp.com/v1
MISSIVE_API_TOKEN=
MISSIVE_USER_ID=
