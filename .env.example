# Server
PORT=3000
POLL_CRON=*/2 * * * *
DB_PATH=./data.sqlite

# --- IRIS CRM (Banquest Helpdesk) ---
IRIS_BASE_URL=https://iris.banquest.com/api
IRIS_WEB_BASE_URL=https://iris.banquest.com
IRIS_API_KEY=
IRIS_USER_ID=
IRIS_USERNAME=
